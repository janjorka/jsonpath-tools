{
	"name": "JSONPath Tools Development Container",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/git-lfs:1": {}
	},
	"forwardPorts": [
		3000
	],
	"portsAttributes": {
		"3000": {
			"label": "JSONPath Playground",
			"protocol": "https",
			"onAutoForward": "openBrowser"
		}
	},
	"postCreateCommand": [
		"npm install",
		"npm run build --workspace @jsonpath-tools/jsonpath",
		"npm run build --workspace @jsonpath-tools/codemirror-lang-jsonpath",
		"npm run build --workspace @jsonpath-tools/jsonpath-editor-react"
	]
	// Configure tool-specific properties.
	// "customizations": {}
}