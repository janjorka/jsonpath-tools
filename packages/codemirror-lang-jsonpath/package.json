{
    "name": "@jsonpath-tools/codemirror-lang-jsonpath",
    "version": "0.5.0-alpha",
    "author": "Jan Jörka",
    "license": "MIT",
    "description": "JSONPath (RFC 9535) language support for CodeMirror editor.",
    "homepage": "https://janjorka.github.io/jsonpath-tools",
    "repository": {
        "type": "git",
        "url": "https://github.com/janjorka/jsonpath-tools",
        "directory": "packages/codemirror-lang-jsonpath"
    },
    "type": "module",
    "main": "dist/index.js",
    "exports": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite --host",
        "build": "tsc && vite build",
        "build-data-type-grammar": "lezer-generator --typeScript lib/data-type/data-type.grammar -o lib/data-type/data-type-parser.ts",
        "preview": "vite preview --host",
        "test": "vitest",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.2",
        "@codemirror/language": "^6.12.3",
        "@codemirror/lint": "^6.9.6",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.42.1",
        "@jsonpath-tools/jsonpath": "^0.5.0-alpha",
        "@lezer/common": "^1.5.2",
        "@lezer/lr": "^1.4.10",
        "@lezer/highlight": "^1.2.3",
        "@lezer/json": "^1.0.3",
        "markdown-it": "^14.1.1"
    },
    "devDependencies": {
        "@lezer/generator": "^1.8.0",
        "@types/markdown-it": "^14.1.2",
        "@microsoft/api-extractor": "7.58.7",
        "typescript": "~6.0.3",
        "vite": "^8.0.11",
        "vite-plugin-dts": "^5.0.0",
        "vitest": "^4.1.5"
    }
}
